{
	"name": "@step-harness/voice-agent",
	"version": "0.84.4",
	"private": true,
	"description": "Voice channel: attaches to an existing agent session and turns voice into AgentInput / events into speech. Peer of coding-agent (no import edge); not a second agent.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run"
	},
	"keywords": [
		"voice",
		"realtime",
		"agent"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@step-harness/contracts": "workspace:*",
		"@step-harness/realtime": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"vitest": "4.1.9"
	}
}
