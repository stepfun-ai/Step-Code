{
	"name": "@step-harness/realtime-voice",
	"version": "0.84.4",
	"private": true,
	"description": "Realtime voice device driver (mic capture / playback / vendor bridge) implementing the neutral RealtimeDriver contract. First phase ships a mock driver; the real audio SDK is added when voice is built.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run"
	},
	"keywords": [
		"realtime",
		"voice",
		"extension"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@step-harness/realtime": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"vitest": "4.1.9"
	}
}
