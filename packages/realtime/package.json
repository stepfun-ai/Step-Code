{
	"name": "@step-harness/realtime",
	"version": "0.84.4",
	"private": true,
	"description": "Neutral realtime-audio contracts: audio frames, turns, interrupts, VAD, and the device-driver capability. Zero runtime dependencies.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run"
	},
	"keywords": [
		"realtime",
		"audio",
		"contracts"
	],
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"vitest": "4.1.9"
	}
}
