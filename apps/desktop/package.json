{
	"name": "@step-harness/desktop",
	"productName": "StepCode",
	"description": "Electron desktop shell around the StepCode Web host and React client",
	"version": "0.84.4",
	"private": true,
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"build": "node scripts/build.mjs",
		"typecheck": "tsgo -p tsconfig.json --noEmit",
		"test": "node --test test/*.test.ts",
		"start": "pnpm --filter @step-harness/web build && node scripts/build.mjs && electron .",
		"dev": "node scripts/build.mjs --ensure-web && electron .",
		"icons": "node scripts/icons.mjs",
		"package": "node scripts/build.mjs && node scripts/package.mjs",
		"package:mac": "node scripts/build.mjs && node scripts/package.mjs --mac",
		"package:win": "node scripts/build.mjs && node scripts/package.mjs --win",
		"clean": "shx rm -rf dist release"
	},
	"dependencies": {
		"@step-harness/web": "workspace:*"
	},
	"devDependencies": {
		"electron": "44.7.0",
		"electron-builder": "26.15.3",
		"esbuild": "0.28.1"
	}
}
