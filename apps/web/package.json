{
	"name": "@step-harness/web",
	"private": true,
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		"./server": "./dist/server.js",
		"./desktop-bridge": "./client/src/platform/desktop-bridge.ts"
	},
	"scripts": {
		"dev": "tsx --tsconfig ../../tsconfig.json src/server.ts",
		"dev:client": "vite",
		"build": "shx rm -rf dist && tsgo -p tsconfig.json && vite build && shx cp openapi.yaml dist/openapi.yaml",
		"build:client": "vite build",
		"test": "TSX_TSCONFIG_PATH=../../tsconfig.json node --import tsx --test test/*.test.ts",
		"test:e2e": "vite build && node --test test/e2e/*.e2e.mjs",
		"typecheck": "tsgo -p tsconfig.json --noEmit && tsgo -p tsconfig.client.json --noEmit"
	},
	"dependencies": {
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@step-harness/coding-agent": "workspace:*",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/xterm": "6.0.0",
		"node-pty": "1.1.0",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"playwright-core": "1.64.1",
		"vite": "8.2.2"
	}
}
