{
	"name": "@step-harness/web",
	"private": true,
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		"./server": "./dist/server.js",
		"./desktop-bridge": "./client/src/platform/desktop-bridge.ts"
	},
	"scripts": {
		"dev": "tsx --tsconfig ../../tsconfig.json src/server.ts",
		"dev:client": "vite",
		"build": "shx rm -rf dist && tsgo -p tsconfig.json && vite build && shx cp openapi.yaml dist/openapi.yaml",
		"build:client": "vite build",
		"test": "tsx --tsconfig ../../tsconfig.json --test test/*.test.ts",
		"test:e2e": "vite build && node --test test/e2e/*.e2e.mjs",
		"typecheck": "tsgo -p tsconfig.json --noEmit && tsgo -p tsconfig.client.json --noEmit"
	},
	"dependencies": {
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@step-harness/coding-agent": "workspace:*",
		"@streamdown/cjk": "1.0.4",
		"@streamdown/code": "2.0.0",
		"@streamdown/math": "1.0.3",
		"@streamdown/mermaid": "1.0.3",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/xterm": "6.0.0",
		"katex": "0.16.47",
		"mdast-util-from-markdown": "2.0.3",
		"mdast-util-gfm": "3.1.0",
		"micromark-extension-gfm": "3.0.0",
		"node-pty": "1.1.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"streamdown": "2.7.1"
	},
	"devDependencies": {
		"@types/mdast": "4.0.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"playwright-core": "1.64.1",
		"vite": "8.2.2"
	}
}
