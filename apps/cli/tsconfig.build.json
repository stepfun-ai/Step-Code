{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"paths": {
			"@earendil-works/pi-coding-agent": ["../../packages/coding-agent/dist/index.d.ts"],
			"@earendil-works/pi-coding-agent/*": ["../../packages/coding-agent/dist/*.d.ts"],
			"@earendil-works/pi-ai": ["../../packages/ai/dist/index.d.ts"],
			"@earendil-works/pi-ai/*": ["../../packages/ai/dist/*.d.ts", "../../packages/ai/dist/providers/*.d.ts"],
			"@step-harness/config": ["../../packages/config/dist/index.d.ts"],
			"@step-harness/contracts": ["../../packages/contracts/dist/in-process/index.d.ts"],
			"@step-harness/contracts/wire": ["../../packages/contracts/dist/wire/index.d.ts"]
		},
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
	"exclude": ["node_modules", "dist"]
}
