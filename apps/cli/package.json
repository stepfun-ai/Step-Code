{
	"name": "@step-harness/cli",
	"private": true,
	"type": "module",
	"bin": {
		"step": "./dist/main.js"
	},
	"imports": {
		"#*": "./src/*.ts"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "npm run build:unbundled",
		"build:unbundled": "tsgo -p tsconfig.build.json",
		"typecheck": "tsgo -p tsconfig.build.json --noEmit",
		"dev": "tsx --tsconfig ../../tsconfig.json src/main.ts",
		"test": "vitest --run --passWithNoTests",
		"smoke": "node ../../scripts/smoke-apps-cli.mjs"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^0.84.4",
		"@earendil-works/pi-ai": "^0.84.4",
		"@earendil-works/pi-coding-agent": "^0.84.4",
		"@earendil-works/pi-tui": "^0.84.4",
		"@step-harness/config": "workspace:*",
		"chalk": "5.6.2",
		"grok-mermaid": "0.2.2"
	},
	"devDependencies": {
		"@types/proper-lockfile": "4.1.4",
		"proper-lockfile": "4.1.2",
		"typebox": "1.3.7",
		"vitest": "4.1.9"
	}
}
