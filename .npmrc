save-exact=true
min-release-age=2
# No `registry=` line on purpose. pnpm-lock.yaml pins the resolved tarball URL of
# each package (the internal Artifactory mirror), so `pnpm install
# --frozen-lockfile` fetches exactly those and a registry here would only change
# what a plain, non-frozen install resolves. A CI runner needs to reach that
# host; if it cannot, fix the runner, not this file.
# Do not add ignore-scripts=true: node-pty and esbuild produce their binaries in
# postinstall, and the desktop installers ship those artifacts.
# Internal workspace packages depend on each other via semver ranges (e.g.
# "^0.84.4") rather than the workspace: protocol. pnpm 9 does not link those to
# local workspace members by default, so it would otherwise resolve them from
# the registry (an older published copy). Force local linking so the monorepo
# builds against live source.
link-workspace-packages=true
prefer-workspace-packages=true
