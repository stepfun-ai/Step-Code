save-exact=true
min-release-age=2
# Internal workspace packages depend on each other via semver ranges (e.g.
# "^0.84.4") rather than the workspace: protocol. pnpm 9 does not link those to
# local workspace members by default, so it would otherwise resolve them from
# the registry (an older published copy). Force local linking so the monorepo
# builds against live source.
link-workspace-packages=true
prefer-workspace-packages=true
