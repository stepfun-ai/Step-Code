{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"*": ["./*"],
			"@earendil-works/pi-telemetry": ["./packages/telemetry/src/index.ts"],
			"@earendil-works/pi-telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@earendil-works/pi-ai": ["./packages/ai/src/index.ts"],
			"@earendil-works/pi-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@earendil-works/pi-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@earendil-works/pi-ai/dist/*": ["./packages/ai/src/*"],
			"@earendil-works/pi-agent-core": ["./packages/agent-loop/src/index.ts"],
			"@earendil-works/pi-agent-core/node": ["./packages/agent-loop/src/node.ts"],
			"@earendil-works/pi-agent-core/session/testing": [
				"./packages/agent-loop/src/harness/session/testing/index.ts"
			],
			"@earendil-works/pi-agent-core/*": ["./packages/agent-loop/src/*"],
			"@earendil-works/pi-coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@earendil-works/pi-coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@earendil-works/pi-coding-agent/*": ["./packages/coding-agent/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@earendil-works/pi-tui": ["./packages/tui/src/index.ts"],
			"@earendil-works/pi-tui/*": ["./packages/tui/src/*"],
			"@earendil-works/pi-agent-old": ["./packages/agent-old/src/index.ts"],
			"@earendil-works/pi-agent-old/*": ["./packages/agent-old/src/*"],
			"@step-harness/cli": ["./apps/cli/src/index.ts"],
			"@step-harness/contracts": ["./packages/contracts/src/in-process/index.ts"],
			"@step-harness/contracts/wire": ["./packages/contracts/src/wire/index.ts"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/coding-agent/examples/**/*", "apps/cli/src/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
